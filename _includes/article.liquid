<!doctype html>
<html lang="en">
    <head>
        {% include head.liquid %}
    </head>
    <body class="{{ bodyClass }}">
    <ilw-page class="ilw-font ilw-margin">
        <header>
            {% include header.liquid %}
        </header>
        <main id="article">
            {% if headImage %}
            <img src="{{ headImage }}" alt="{{ headAlt }}" class="headImage">
            {% endif %}
            <ilw-content>
                {% if section %}
                <div class="section-pill {{ section }}">{{ section }}</div>
                {% endif %}
                <h1>{{ pageTitle }}</h1>
                {% if byline %}
                <p class="byline article-byline">{{ byline }}</p>
                {% endif %}
            </ilw-content>
            {{ content }}
            {% include arrows.liquid %}
        </main>
        {% include footer.liquid %}
    </ilw-page>
    </body>
</html>